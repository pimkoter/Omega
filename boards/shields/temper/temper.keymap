#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/modifiers.h>

#define DEFAULT 0
#define SYM     1
#define NAV     2
#define SYS     3

#define MEH     LS(LA(LCTRL))

/ {
    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <
                5  6  7  8  9
                15 16 17 18 19
                25 26 27 28 29
            >;
            hold-trigger-on-release;
        };
        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <
                0  1  2  3  4
                10 11 12 13 14
                20 21 22 23 24
            >;
            hold-trigger-on-release;
        };
        nav_a: nav_a {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&mo>, <&kp>;
            hold-trigger-key-positions = <
                5  6  7  8  9
                15 16 17 18 19
                25 26 27 28 29
            >;
        };
        tap_hold: tap_hold {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&sl>, <&kp>;
        };
        td_shift_tab: td_shift_tab {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&sk LSHIFT>, <&kp TAB>;
        };
        td_z_esc: td_z_esc {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp Z>, <&kp ESC>;
        };
    };
    keymap {
        compatible = "zmk,keymap";
        default_layer {
            bindings = <
                &kp Q          &kp W          &kp F          &kp P          &kp B
                &kp J         &kp L          &kp U          &kp Y          &kp SEMI

                &nav_a NAV A   &hml LALT R    &hml LCTRL S   &hml LGUI T   &kp G
                &kp M          &hmr RGUI N   &hmr RCTRL E   &hmr RALT I    &kp O

                &td_z_esc      &kp X          &kp C          &kp D          &kp V
                &kp K          &kp H          &kp COMMA      &kp DOT        &kp FSLH

                                            &td_shift_tab
                                            &kp BSPC
                                            &tap_hold SYM MEH
                                            &key_repeat
                                            &kp SPACE
                                            &lt SYS ENTER
            >;
        };
        sym_layer {
            bindings = <
                &kp DLLR       &kp PLUS       &kp LPAR       &kp RPAR       &kp AT
                &kp PIPE       &kp SQT        &kp EQUAL      &kp UNDER      &kp ASTRK

                &kp N1         &kp N2         &kp N3         &kp N4         &kp N5
                &kp N6         &kp N7         &kp N8         &kp N9         &kp N0

                &kp EXCL       &kp HASH       &kp LBRC       &kp RBRC       &kp TILDE
                &kp AMPS       &kp LBKT       &kp RBKT       &kp PRCNT      &kp CARET

                                            &trans
                                            &trans
                                            &trans
                                            &trans
                                            &trans
                                            &trans
            >;
        };
        nav_layer {
            bindings = <
                &trans        &trans        &trans        &trans        &trans
                &trans        &trans        &trans        &trans        &trans

                &trans        &trans        &trans        &trans        &trans
                &kp LEFT      &kp DOWN      &kp UP        &kp RIGHT     &trans

                &trans        &trans        &trans        &trans        &trans
                &trans        &trans        &trans        &trans        &trans

                                            &trans
                                            &trans
                                            &trans
                                            &trans
                                            &trans
                                            &trans
            >;
        };
        sys_layer {
            bindings = <
                &kp F1         &kp F2         &kp F3         &kp F4         &kp F5
                &kp F6         &kp F7         &kp F8         &kp F9         &kp F10

                &kp F11        &kp C_VOL_DN   &kp C_MUTE      &kp C_VOL_UP   &kp F12
                &none          &none          &none          &none           &none

                &kp C_PREV     &kp C_PP       &kp C_NEXT      &kp C_BRI_DN    &kp C_BRI_UP
                &none          &none          &none          &bootloader     &sys_reset

                                            &trans
                                            &trans
                                            &trans
                                            &trans
                                            &trans
                                            &trans
            >;
        };
    };
};

/*
 * ====================================================================
 * LAYOUT REFERENCE
 * ====================================================================
 *
 * DEFAULT
 *
 * ┌────┬────┬────┬────┬────┐     ┌────┬────┬────┬────┬────┐
 * │ Q  │ W  │ F  │ P  │ B  │     │ J  │ L  │ U  │ Y  │ ;  │
 * ├────┼────┼────┼────┼────┤     ├────┼────┼────┼────┼────┤
 * │ A  │ R  │ S  │ T  │ G  │     │ M  │ N  │ E  │ I  │ O  │
 * │NAV │ALT │CTL │GUI │    │     │    │GUI │CTL │ALT │    │
 * ├────┼────┼────┼────┼────┤     ├────┼────┼────┼────┼────┤
 * │ Z  │ X  │ C  │ D  │ V  │     │ K  │ H  │ ,  │ .  │ /  │
 * │ESC │    │    │    │    │     │    │    │    │    │    │
 * └────┴────┴────┴────┴────┘     └────┴────┴────┴────┴────┘
 *
 * T1 = Shift / Tab
 * T2 = Backspace
 * T3 = SYM / Meh
 * T4 = Repeat
 * T5 = Space
 * T6 = Enter / SYS
 *
 *
 * SYMBOLS
 *
 * ┌────┬────┬────┬────┬────┐     ┌────┬────┬────┬────┬────┐
 * │ $  │ +  │ (  │ )  │ @  │     │ |  │ '  │ =  │ _  │ *  │
 * ├────┼────┼────┼────┼────┤     ├────┼────┼────┼────┼────┤
 * │ 1  │ 2  │ 3  │ 4  │ 5  │     │ 6  │ 7  │ 8  │ 9  │ 0  │
 * ├────┼────┼────┼────┼────┤     ├────┼────┼────┼────┼────┤
 * │ !  │ #  │ {  │ }  │ ~  │     │ &  │ [  │ ]  │ %  │ ^  │
 * └────┴────┴────┴────┴────┘     └────┴────┴────┴────┴────┘
 *
 *
 * NAV
 *
 * ┌────┬────┬────┬────┬────┐     ┌────┬────┬────┬────┬────┐
 * │    │    │    │    │    │     │    │    │    │    │    │
 * ├────┼────┼────┼────┼────┤     ├────┼────┼────┼────┼────┤
 * │    │    │    │    │    │     │ ←  │ ↓  │ ↑  │ →  │    │
 * ├────┼────┼────┼────┼────┤     ├────┼────┼────┼────┼────┤
 * │    │    │    │    │    │     │    │    │    │    │    │
 * └────┴────┴────┴────┴────┘     └────┴────┴────┴────┴────┘
 *
 *
 * SYS
 *
 * ┌──────┬──────┬──────┬──────┬──────┐     ┌──────┬──────┬──────┬──────┬──────┐
 * │  F1  │  F2  │  F3  │  F4  │  F5  │     │  F6  │  F7  │  F8  │  F9  │ F10  │
 * ├──────┼──────┼──────┼──────┼──────┤     ├──────┼──────┼──────┼──────┼──────┤
 * │ F11  │ VOL- │ MUTE │ VOL+ │ F12  │     │      │      │      │      │      │
 * ├──────┼──────┼──────┼──────┼──────┤     ├──────┼──────┼──────┼──────┼──────┤
 * │ PREV │ PLAY │ NEXT │ BRI- │ BRI+ │     │      │      │      │ BOOT │RESET │
 * └──────┴──────┴──────┴──────┴──────┘     └──────┴──────┴──────┴──────┴──────┘
 */
