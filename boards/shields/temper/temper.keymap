#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MEH   LS(LA(LCTRL))
#define HYPER LG(LS(LA(LCTRL)))

#define NEXT_LAYER(behavior, layer) behavior HYPER layer

/ {
    behaviors {
        next_layer: next_layer {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&to>;
        };

        /*
         * Space:
         *   tap  -> Space
         *   hold -> Meh
         */
        space_meh: space_meh {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /*
         * 0 NORMAL
         *
         * Q W F P B | J L U Y ;
         * A R S T G | M N E I O
         * Z X C D V | K H , . /
         *
         * T1 T2 T3 | T4 T5 T6
         */

        normal_layer {
            display-name = "NORMAL";

            bindings = <
                
                &kp Q &kp W      &kp F      &kp P         &kp B &kp J     &kp L                &kp U      &kp Y      &kp SEMI
                &kp A &mt LALT R &mt LGUI S &mt LCTRL T   &kp G &kp M     &mt RCTRL N          &mt RGUI E &mt RALT I &kp O
                &kp Z &kp X      &kp C      &kp D         &kp V &kp K     &kp H                &kp COMMA  &kp DOT    &kp FSLH
                                 &sk LSHIFT &kp BACKSPACE &sl 1 &kp ENTER &space_meh MEH SPACE &key_repeat
            >;
        };

        oneshot_layer {
            display-name = "ONESHOT";

            bindings = <
                &kp EXCL &kp AT               &kp HASH              &kp DLLR       &kp PRCNT           &kp CARET &kp AMPS            &kp ASTERISK &kp TILDE   &kp EQUAL
                &kp ESC  &kp LEFT_PARENTHESIS &kp RIGHT_PARENTHESIS &kp LEFT_BRACE &kp RIGHT_BRACE     &kp PLUS  &to 2                &to 3        &kp  MINUS &kp GRAVE
                &kp TAB  &kp LEFT_BRACKET     &kp RIGHT_BRACKET     &kp LT         &kp GT              &kp BSLH  &kp PIPE             &kp APOS     &kp DQT    &kp QUESTION
                                              &sk LSHIFT            &kp BACKSPACE  &next_layer HYPER 2 &to 0     &space_meh MEH SPACE &key_repeat
            >;
        };

        nav_layer {
            display-name = "NAV";

            bindings = <
                &kp GRAVE &msc SCRL_LEFT &mmv MOVE_UP   &msc SCRL_RIGHT &kp LG(Q)           &kp C_AC_BACK &kp LS(LC(TAB))      &kp LC(TAB)      &kp C_AC_FORWARD  &kp BACKSPACE
                &kp ESC   &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &kp DELETE          &kp LEFT      &kp DOWN             &kp UP           &kp RIGHT         &kp ENTER
                &kp TAB   &mkp RCLK      &msc SCRL_UP   &msc SCRL_DOWN  &none               &mkp LCLK     &none                &none            &none             &none
                                         &sk LSHIFT     &kp BACKSPACE   &next_layer HYPER 3 &to 0         &space_meh MEH SPACE &key_repeat
            >;
        };

      num_layer {
          display-name = "NUM";

          bindings = <
              &none   &kp C_PP &kp C_PREV   &kp C_NEXT    &none    &kp MINUS &kp N7               &kp N8 &kp N9 &kp BACKSPACE
              &kp ESC &none    &kp C_VOL_DN &kp C_VOL_UP  &none    &kp EQUAL &kp N4               &kp N5 &kp N6 &kp ENTER
              &kp TAB &none    &kp C_BRI_DN &kp C_BRI_UP  &none    &kp N0    &kp N1               &kp N2 &kp N3 &none
                               &sk LSHIFT   &kp BACKSPACE &none    &kp HYPER &space_meh MEH SPACE &key_repeat
          >;
      };
    };
};
